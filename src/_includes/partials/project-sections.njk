{% for section in sections %}
{% set heading = section.heading | trim %}
<div class="project-section{% if not heading %} project-section--full{% endif %}">
  {% if heading %}
  <div class="project-col1">
    <h3>{{ heading }}</h3>
    <div style="clear: both;"></div>
  </div>
  {% endif %}
  <div class="project-col2">
    {% for block in section.blocks %}
      {% if block.type == "text" %}
        {{ block.body | renderMarkdown | safe }}
      {% elif block.type == "images" %}
        <div class="project-image-block">
          {% for image in block.items %}
            {% set showBackground = image.showBackground | default(true) %}
            <div class="project-image{% if showBackground %} project-image--framed{% endif %}">
              {% set imgWidth = image.width | default(100) %}
              <img style="width: {{ imgWidth }}%; height: auto; max-width: 100%; display: block; margin: 0 auto;" src="{{ image.src | projectImageSrc(slug) }}" alt="{{ image.caption }}">
              {% if image.caption %}
              <p class="project-image-caption">{{ image.caption }}</p>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      {% endif %}
    {% endfor %}
    <div style="clear: both;"></div>
  </div>
</div>
{% endfor %}
